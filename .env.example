TELEGRAM_BOT_TOKEN=
# Порожнє значення або [] дозволяє всім користувачам доступ, включно з адмініструванням.
ALLOWED_USER_IDS=[123456789]
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=gemma4:12b
BOT_TIMEZONE=Europe/Kyiv
DATA_DIR=./data
EXTENSIONS_DIR=./data/extensions
FILESYSTEM_ROOT=./workspace
FILESYSTEM_MAX_FILE_BYTES=262144
# Типово DATA_DIR/databases; службові state/session завжди read-only.
SQLITE_DATABASE_DIR=./data/databases
SQLITE_QUERY_TIMEOUT_SECONDS=5
SQLITE_MAX_ROWS=100
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=10
CONSOLE_TIMEOUT_SECONDS=30
CONSOLE_MAX_OUTPUT_BYTES=6000
SCREENSHOT_TIMEOUT_SECONDS=10
SCREENSHOT_MAX_BYTES=20000000
SANDBOX_MEMORY_MB=512
# Порожнє значення або [] дозволяє всі пакети; заповнений список обмежує дозволені package==version.
ALLOWED_DEPENDENCIES=[]
MAX_PARALLEL_TASKS=2
QUEUE_SIZE=32
TASK_TIMEOUT_SECONDS=300
MODEL_TIMEOUT_SECONDS=120
SANDBOX_TIMEOUT_SECONDS=30
MAX_LLM_CALLS=16
MAX_DELEGATION_DEPTH=3
MAX_CONTEXT_CHARS=48000
MAX_INPUT_CHARS=12000
SHUTDOWN_TIMEOUT_SECONDS=20
RESTART_COOLDOWN_SECONDS=60
